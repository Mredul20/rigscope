1 ICON "icon.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Rigscope contributors"
      VALUE "FileDescription", "Rigscope - PC specs, compatibility and security check"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "Rigscope"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "Rigscope.exe"
      VALUE "ProductName", "Rigscope"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
